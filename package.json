{
  "name": "crawlable",
  "version": "1.0.0",
  "private": true,
  "description": "Crawlable — see what AI crawlers actually read on your site, and generate the files that fix it.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "social:queue": "tsx scripts/social/post.ts",
    "seo:report": "tsx scripts/seo/report.ts",
    "seo:dogfood": "tsx scripts/seo/dogfood.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mdx-js/mdx": "3.1.1",
    "cheerio": "1.0.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "^15.5.25",
    "postgres": "3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-gfm": "4.0.1",
    "resend": "4.1.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
