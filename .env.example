# ---------------------------------------------------------------------------
# Crawlable environment
#
# Copy to .env.local for development. In production set these in your host's
# environment settings — never commit a filled-in copy of this file.
#
# The app starts with none of these set: it falls back to an in-memory store,
# disables checkout, and skips email. /api/health reports exactly which
# subsystems are degraded, so check it after every deploy.
# ---------------------------------------------------------------------------

# Public origin. Used for checkout redirects, canonical URLs, sitemap and email
# links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (optional in development, REQUIRED in production)
#
# Any Postgres 13+ connection string: Neon, Supabase, Vercel Postgres, RDS.
# Without it the app uses an in-memory store that is wiped on every cold start,
# which means license records and audit history do not survive.
#
# If your provider uses a transaction-mode pooler (PgBouncer, Supabase :6543),
# use the pooled URL — the driver is configured with prepare:false for this.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/crawlable?sslmode=require

# ---------------------------------------------------------------------------
# Lemon Squeezy (merchant of record — handles global VAT and sales tax)
#
# Setup, in order:
#  1. Create a store, then three products:
#       "Single Audit"  — one-time, $39
#       "Growth Pack"   — one-time, $89
#       "Agency Pro"    — subscription, $29/month
#  2. Enable license keys on all three products
#       (Product → Licensing → "Generate license keys for this product").
#       Set activation limit to unlimited; Crawlable meters usage itself.
#  3. Settings → API → create an API key            -> LEMONSQUEEZY_API_KEY
#  4. Settings → Stores → copy the store ID          -> LEMONSQUEEZY_STORE_ID
#  5. Each product → Variants → copy the variant ID  -> LEMONSQUEEZY_VARIANT_*
#  6. Settings → Webhooks → create a webhook:
#       URL:    https://YOUR-DOMAIN/api/webhooks/lemonsqueezy
#       Events: order_created, license_key_created, subscription_created,
#               subscription_updated, subscription_cancelled,
#               subscription_expired
#       Signing secret -> LEMONSQUEEZY_WEBHOOK_SECRET
# ---------------------------------------------------------------------------
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_VARIANT_SINGLE=
# LEMONSQUEEZY_VARIANT_PACK=
# LEMONSQUEEZY_VARIANT_AGENCY=

# ---------------------------------------------------------------------------
# Email (optional — transactional delivery via Resend)
#
# Verify your sending domain in Resend before going live, or purchase receipts
# land in spam. EMAIL_FROM must use the verified domain.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Crawlable <hello@yourdomain.com>

# ---------------------------------------------------------------------------
# Cron / internal endpoints
#
# A shared secret required by scheduled jobs. Generate with:
#   openssl rand -hex 32
# On Vercel, set this and the platform sends it as the Authorization header
# for vercel.json cron invocations.
# ---------------------------------------------------------------------------
# CRON_SECRET=
#
# CRON_SECRET also guards the Lemon Squeezy configuration diagnostic, which
# reads each configured variant back from the API and compares its price,
# billing category and license-key setting against lib/plans.ts:
#
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        https://usecrawlable.com/api/health/lemonsqueezy
#
# 200 means every variant matches; 503 means something does not, and the body
# names the variable to fix. With CRON_SECRET unset the endpoint is disabled
# rather than public.

# ---------------------------------------------------------------------------
# Public beta: free deep audit
# ---------------------------------------------------------------------------
# 'true' lets any visitor run a full 40-page audit with no licence key.
# Anything else — absent, empty, 'TRUE', '1' — means standard behaviour: one
# free page, multi-page behind a licence. The flag fails closed on purpose.
#
# It does NOT move the paid boundary. The Fix Kit is still licence-only, is
# not generated for an anonymous run at all, and the download route refuses
# any report no licence owns.
#
# NEXT_PUBLIC_ is inlined at BUILD time, so changing this in Vercel needs a
# redeploy to take effect — it is not a runtime switch.
# NEXT_PUBLIC_BETA_FREE_DEEP_AUDIT=true

# ---------------------------------------------------------------------------
# Contact form relay (Brevo)
# ---------------------------------------------------------------------------
# Without BREVO_API_KEY the contact form returns a 500 and the message is lost,
# so set it before linking /contact anywhere public.
# Key: Brevo dashboard -> SMTP & API -> API Keys.
# BREVO_API_KEY=
#
# Where submissions land. Defaults to support@usecrawlable.com.
# CONTACT_EMAIL_TO=support@usecrawlable.com
#
# The From address on relayed mail. MUST be a sender Brevo has verified for
# this account, or every send is rejected. The submitter's own address goes in
# replyTo instead -- putting it in From would fail SPF/DKIM and land in spam.
# CONTACT_EMAIL_FROM=support@usecrawlable.com

# ---------------------------------------------------------------------------
# Trader identity and email opt-out  (REQUIRED before any promotional email)
# ---------------------------------------------------------------------------
# These have no defaults on purpose. A wrong address is a false statement
# about who is selling; a missing one is merely missing. So promotional email
# refuses to send until both the address and the signing secret are set, and
# the site footer omits the identity block rather than printing a placeholder.
#
# Why it matters, concretely: CAN-SPAM (15 U.S.C. 7704(a)(5)) requires a valid
# physical postal address and a working opt-out in every commercial email, and
# the FTC counts EACH non-compliant message as its own violation -- currently
# up to $53,088 per email. UAE and EU consumer rules separately require a
# trader's legal name and address to be identifiable before a purchase.
#
# NOTE: the site footer is statically prerendered, so these must be present at
# BUILD time. Setting them in Vercel without redeploying leaves the public
# footer empty while /api/health/compliance reports them as set.
#
# BUSINESS_LEGAL_NAME=Your Company FZ-LLC
# BUSINESS_POSTAL_ADDRESS=Office 000, Some Tower, Street, Dubai, United Arab Emirates
# BUSINESS_REGISTRATION=            # trade licence / company number (optional)
#
# Signs unsubscribe tokens. Min 16 chars: openssl rand -hex 32
# Rotating it invalidates unsubscribe links in already-delivered mail, so
# rotate only if it leaks -- people already suppressed stay suppressed, but a
# link in an old email would stop working.
# UNSUBSCRIBE_SECRET=
#
# Check all of the above in a deployed environment with:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#        https://usecrawlable.com/api/health/compliance

# ---------------------------------------------------------------------------
# Distribution automation (optional — used only by scripts/, never by the app)
# ---------------------------------------------------------------------------
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
