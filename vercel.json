{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": [
    "iad1"
  ],
  "functions": {
    "app/api/audit/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/scan/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/webhooks/lemonsqueezy/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/nudge",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
